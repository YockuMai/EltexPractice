#include <unistd.h>
#include <stdio.h>
#include <errno.h>

int main(void)
{
    char *const argv[] = { "/usr/bin/dmesg", NULL };
    char *const envp[] = { NULL };

    execve("/usr/bin/dmesg", argv, envp);
    perror("execve");
    return 1;
}
